{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piku.local/schemas/context-resolution.schema.json",
  "title": "Piku context resolution record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "role", "checkpoint", "resolver", "request", "capability_profile", "status", "cache", "started_at", "finished_at", "items", "warnings", "error", "materialized_artifact_refs"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "checkpoint": { "type": "string", "minLength": 1 },
    "resolver": { "$ref": "#/$defs/resolver" },
    "request": { "$ref": "#/$defs/request" },
    "capability_profile": { "$ref": "#/$defs/capabilityProfile" },
    "status": { "enum": ["succeeded", "failed"] },
    "cache": { "$ref": "#/$defs/cache" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/contextItem" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "error": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/error" }] },
    "materialized_artifact_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "succeeded" } }, "required": ["status"] },
      "then": { "properties": { "items": { "minItems": 1 }, "error": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "properties": { "items": { "maxItems": 0 }, "error": { "$ref": "#/$defs/error" } } }
    },
    {
      "if": { "properties": { "request": { "properties": { "replay_mode": { "const": "exact" } }, "required": ["replay_mode"] } } },
      "then": { "properties": { "cache": { "properties": { "decision": { "const": "captured" } } } } }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "config_sha256", "code_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "config_sha256": { "$ref": "#/$defs/sha256" },
        "code_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_plane", "replay_mode", "byte_budget", "token_budget", "deadline_ms", "freshness_policy"],
      "properties": {
        "output_plane": { "enum": ["instruction", "message", "tool", "state", "artifact"] },
        "replay_mode": { "enum": ["exact", "refresh", "fork"] },
        "byte_budget": { "type": "integer", "minimum": 0 },
        "token_budget": { "type": "integer", "minimum": 0 },
        "deadline_ms": { "type": "integer", "minimum": 1 },
        "freshness_policy": { "enum": ["captured", "current", "max_age"] }
      }
    },
    "capabilityProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "key_sha256"],
      "properties": {
        "decision": { "enum": ["miss", "hit", "captured", "bypass"] },
        "key_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "contextItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resolver_id", "resolver_version", "output_plane", "media_type", "sources", "trust", "freshness", "sensitivity", "priority", "byte_size", "token_estimate", "output_sha256", "created_at", "expires_at", "warnings"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "resolver_id": { "type": "string", "minLength": 1 },
        "resolver_version": { "type": "string", "minLength": 1 },
        "output_plane": { "enum": ["instruction", "message", "tool", "state", "artifact"] },
        "media_type": { "type": "string", "minLength": 1 },
        "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "trust": { "enum": ["control", "operator_instruction", "host_fact", "untrusted_evidence", "derived_evidence"] },
        "freshness": { "enum": ["captured", "current", "stale", "unknown"] },
        "sensitivity": { "enum": ["public", "workspace", "private", "secret"] },
        "priority": { "type": "integer" },
        "inline_payload": { "type": "string" },
        "payload_ref": { "type": "string", "minLength": 1 },
        "byte_size": { "type": "integer", "minimum": 0 },
        "token_estimate": { "type": "integer", "minimum": 0 },
        "output_sha256": { "$ref": "#/$defs/sha256" },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": ["string", "null"], "format": "date-time" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "oneOf": [
        { "required": ["inline_payload"], "not": { "required": ["payload_ref"] } },
        { "required": ["payload_ref"], "not": { "required": ["inline_payload"] } }
      ],
      "allOf": [
        {
          "if": { "properties": { "output_plane": { "const": "instruction" } }, "required": ["output_plane"] },
          "then": { "properties": { "trust": { "enum": ["control", "operator_instruction"] } } }
        },
        {
          "if": { "properties": { "trust": { "const": "derived_evidence" } }, "required": ["trust"] },
          "then": { "properties": { "sources": { "minItems": 1 } } }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
