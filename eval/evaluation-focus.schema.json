{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piku.dev/schemas/evaluation-focus-v1.json",
  "title": "Piku active evaluation focus projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "subject_state_hash", "projected_at", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "subject_state_hash": {
      "type": "string", "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "projected_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "promotion_id", "proposal_id", "scope", "category", "question",
          "task_clause", "evidence_refs", "source_run_id", "activates_at",
          "expires_at", "max_prompt_bytes", "retest_obligation"
        ],
        "properties": {
          "promotion_id": { "type": "string", "minLength": 1 },
          "proposal_id": { "type": "string", "minLength": 1 },
          "scope": { "$ref": "evaluation-focus-event.schema.json#/$defs/scope" },
          "category": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 2, "pattern": "\\?$" },
          "task_clause": { "type": "string", "minLength": 1 },
          "evidence_refs": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "source_run_id": { "type": "string", "minLength": 1 },
          "activates_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" },
          "max_prompt_bytes": { "type": "integer", "minimum": 1 },
          "retest_obligation": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    }
  }
}
