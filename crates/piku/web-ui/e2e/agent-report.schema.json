{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": { "type": "string", "enum": ["passed", "failed", "blocked"] },
    "summary": { "type": "string" },
    "surface": {
      "type": "string",
      "pattern": "^qa-[A-Za-z0-9-]+$"
    },
    "coverage": {
      "type": "array",
      "minItems": 8,
      "items": { "type": "string" }
    },
    "journey": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "phase": {
            "type": "string",
            "enum": ["ORIENT", "DISCOVER", "CONSTRUCT", "MANIPULATE", "TRUST", "STRESS", "REFLOW", "REFLECT"]
          },
          "intent": { "type": "string" },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "observation": { "type": "string" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "required": ["phase", "intent", "actions", "observation", "evidence"]
      }
    },
    "design_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comprehension": { "type": "integer", "minimum": 1, "maximum": 5 },
        "direct_manipulation": { "type": "integer", "minimum": 1, "maximum": 5 },
        "system_visibility": { "type": "integer", "minimum": 1, "maximum": 5 },
        "authority_clarity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "visual_coherence": { "type": "integer", "minimum": 1, "maximum": 5 },
        "responsive_usability": { "type": "integer", "minimum": 1, "maximum": 5 },
        "rationale": { "type": "string" }
      },
      "required": [
        "comprehension",
        "direct_manipulation",
        "system_visibility",
        "authority_clarity",
        "visual_coherence",
        "responsive_usability",
        "rationale"
      ]
    },
    "product_thesis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task_outcome": {
          "type": "string",
          "enum": ["completed", "partial", "blocked"]
        },
        "operator_summary": { "type": "string" },
        "verdict": {
          "type": "string",
          "enum": ["supported", "partial", "not_supported"]
        },
        "dimensions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "enum": [
                  "task_comprehension",
                  "action_provenance",
                  "state_visibility",
                  "context_control",
                  "rerun_semantics",
                  "recovery",
                  "authority_clarity",
                  "spatial_utility"
                ]
              },
              "score": { "type": "integer", "minimum": 1, "maximum": 5 },
              "result": {
                "type": "string",
                "enum": ["demonstrated", "partial", "absent", "blocked"]
              },
              "evidence": { "type": "string" }
            },
            "required": ["name", "score", "result", "evidence"]
          }
        }
      },
      "required": ["task_outcome", "operator_summary", "verdict", "dimensions"]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "title": { "type": "string" },
          "evidence": { "type": "string" },
          "reproduction": {
            "type": "array",
            "items": { "type": "string" }
          },
          "suggested_fix": { "type": "string" }
        },
        "required": [
          "severity",
          "title",
          "evidence",
          "reproduction",
          "suggested_fix"
        ]
      }
    },
    "followups": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["todo", "idea", "retest"] },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "perspective": { "type": ["string", "null"] },
          "evidence_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "required": [
          "kind",
          "priority",
          "title",
          "rationale",
          "perspective",
          "evidence_ids"
        ]
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string" }
    }
  },
  "required": [
    "status",
    "summary",
    "surface",
    "coverage",
    "journey",
    "design_assessment",
    "product_thesis",
    "findings",
    "followups",
    "artifacts"
  ]
}
