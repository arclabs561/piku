{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["supported", "partial", "not_supported", "inconclusive"] },
    "summary": { "type": "string", "minLength": 1 },
    "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "disagreements": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "title": { "type": "string" },
          "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "required": ["severity", "title", "evidence_ids"]
      }
    },
    "followups": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["todo", "idea", "retest"] },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "perspective": { "type": ["string", "null"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["kind", "priority", "title", "rationale", "perspective", "evidence_ids"]
      }
    }
  },
  "required": ["verdict", "summary", "evidence_ids", "disagreements", "findings", "followups"]
}
