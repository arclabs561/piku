{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "perspective": { "type": "string", "enum": ["coding_trace", "recovery"] },
    "surface": { "type": "string", "pattern": "^qa-[A-Za-z0-9-]+$" },
    "request_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["completed", "blocked"] },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 480 },
        "device_scale_factor": { "type": "number", "exclusiveMinimum": 0 },
        "color_scheme": { "type": "string", "enum": ["light", "dark", "no-preference"] },
        "canvas_scroll_x": { "type": "number", "minimum": 0 },
        "canvas_scroll_y": { "type": "number", "minimum": 0 }
      },
      "required": ["width", "height", "device_scale_factor", "color_scheme", "canvas_scroll_x", "canvas_scroll_y"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "probes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^p[1-9][0-9]*$" },
          "intent": { "type": "string", "minLength": 1 },
          "expected_outcome": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "observed_outcome": { "type": "string", "minLength": 1 },
          "consequence": { "type": "string", "minLength": 1 },
          "next_probe": { "type": "string", "minLength": 1 },
          "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "required": ["id", "intent", "expected_outcome", "action", "observed_outcome", "consequence", "next_probe", "evidence_ids"]
      }
    },
    "causal_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/hypothesis" }
        },
        "validity": { "$ref": "#/$defs/validity" }
      },
      "required": ["hypotheses", "validity"]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+:[A-Za-z0-9._-]+$" },
          "kind": { "type": "string", "enum": ["dom", "screenshot", "network", "console", "action", "predicate"] },
          "observation": { "type": "string", "minLength": 1 },
          "artifact": { "type": ["string", "null"] },
          "artifact_metadata": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "size_bytes": { "type": "integer", "minimum": 0 },
              "media_type": { "type": "string", "minLength": 1 },
              "producer_event_id": { "type": "string", "minLength": 1 },
              "producer_tool": { "type": "string", "minLength": 1 }
            },
            "required": ["sha256", "size_bytes", "media_type", "producer_event_id", "producer_tool"]
          }
        },
        "required": ["id", "kind", "observation", "artifact", "artifact_metadata"]
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^f[1-9][0-9]*$" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "title": { "type": "string" },
          "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "required": ["id", "severity", "title", "evidence_ids"]
      }
    },
    "followups": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^o[1-9][0-9]*$" },
          "kind": { "type": "string", "enum": ["todo", "idea", "retest"] },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "perspective": { "type": ["string", "null"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "finding_ids": {
            "type": "array",
            "items": { "type": "string", "pattern": "^f[1-9][0-9]*$" }
          },
          "retest_of": { "type": ["string", "null"], "minLength": 1 }
        },
        "required": ["id", "kind", "priority", "title", "rationale", "perspective", "evidence_ids", "finding_ids", "retest_of"]
      }
    }
  },
  "required": ["perspective", "surface", "request_id", "status", "viewport", "summary", "probes", "causal_assessment", "evidence", "findings", "followups"],
  "$defs": {
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^h[1-9][0-9]*$" },
        "mechanism": { "type": "string", "minLength": 1 },
        "prediction": { "type": "string", "minLength": 1 },
        "falsifier": { "type": "string", "minLength": 1 },
        "observed_outcome": { "type": "string", "minLength": 1 },
        "disposition": { "type": "string", "enum": ["supported", "disconfirmed", "mixed", "not_tested"] },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "confounders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "factor": { "type": "string", "minLength": 1 },
              "possible_effect": { "type": "string", "minLength": 1 }
            },
            "required": ["factor", "possible_effect"]
          }
        },
        "alternative_explanations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "explanation": { "type": "string", "minLength": 1 },
              "distinguishing_test": { "type": "string", "minLength": 1 }
            },
            "required": ["explanation", "distinguishing_test"]
          }
        }
      },
      "required": ["id", "mechanism", "prediction", "falsifier", "observed_outcome", "disposition", "evidence_ids", "confounders", "alternative_explanations"]
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["valid", "compromised", "inconclusive"] },
        "compromised_by": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["status", "compromised_by", "rationale", "evidence_ids"]
    }
  }
}
