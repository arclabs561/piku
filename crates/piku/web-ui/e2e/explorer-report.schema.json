{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "perspective": { "type": "string", "enum": ["coding_trace", "recovery"] },
    "surface": { "type": "string", "pattern": "^qa-[A-Za-z0-9-]+$" },
    "request_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["completed", "blocked"] },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 320 },
        "height": { "type": "integer", "minimum": 480 },
        "device_scale_factor": { "type": "number", "exclusiveMinimum": 0 },
        "color_scheme": { "type": "string", "enum": ["light", "dark", "no-preference"] },
        "canvas_scroll_x": { "type": "number", "minimum": 0 },
        "canvas_scroll_y": { "type": "number", "minimum": 0 }
      },
      "required": ["width", "height", "device_scale_factor", "color_scheme", "canvas_scroll_x", "canvas_scroll_y"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z_]+:[A-Za-z0-9._-]+$" },
          "kind": { "type": "string", "enum": ["dom", "screenshot", "network", "console", "action", "predicate"] },
          "observation": { "type": "string", "minLength": 1 },
          "artifact": { "type": ["string", "null"] }
        },
        "required": ["id", "kind", "observation", "artifact"]
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "title": { "type": "string" },
          "evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        },
        "required": ["severity", "title", "evidence_ids"]
      }
    },
    "followups": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": { "type": "string", "enum": ["todo", "idea", "retest"] },
          "priority": { "type": "string", "enum": ["high", "medium", "low"] },
          "title": { "type": "string" },
          "rationale": { "type": "string" },
          "perspective": { "type": ["string", "null"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["kind", "priority", "title", "rationale", "perspective", "evidence_ids"]
      }
    }
  },
  "required": ["perspective", "surface", "request_id", "status", "viewport", "summary", "evidence", "findings", "followups"]
}
